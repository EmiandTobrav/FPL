*.parquet filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.joblib filter=lfs diff=lfs merge=lfs -text
*.cbm filter=lfs diff=lfs merge=lfs -text


# Frozen research inputs are ordinary small gzip blobs, never LFS pointers.
research/current/**/*.gz -filter -diff -merge

# Preserve frozen CSV bytes while recognizing their existing CRLF line endings.
*.csv whitespace=cr-at-eol

# Exact vendor copies retain their original terminal blank lines.
model_lab/vendor/** whitespace=-blank-at-eof

# Byte-preserved research source snapshots retain original whitespace.
releases/2026-10-26/implementation/** whitespace=-blank-at-eof,-blank-at-eol
