  ],
  "target_columns": {
    "1": "target_total_points",
    "3": "target_points_h3",
    "6": "target_points_h6"
  },
  "target_availability_rule": "Entire observed horizon finished; max actual kickoff plus chosen clock availability lag, strictly before retraining time. Missing targets have no availability.",
  "missing_policy": "New feature values remain NaN/None where unavailable. Known counts and missing flags accompany them. Existing 21-feature baseline preserves explicit zero/cold-start convention. No fitted imputation or scaling.",
  "metadata_policy": "Last known position/club only, never target-round metadata. Player code is an identifier, not a numeric feature.",
  "excluded": [
    "current/future opponent or fixture calendar without documented schedule snapshots",
    "target-round outcomes",
    "quality flags as features",
    "ownership",
    "full future-season player aggregates"
  ],
  "feature_notes": {
    "windows": "last 3/5/10 available observed player-rounds, may cross seasons; gaps not invented",
    "std": "population standard deviation, known values only",
    "ewm": "calendar-time half-lives 28/84 days; prefix ratio over available observations",
    "per90": "known numerator and minutes from same observations; missing when zero known minutes",
    "start_share": "fraction of observed rounds with at least one start, not fraction of fixtures",
    "sixty_minute_share": "round sum threshold; does not recreate per-fixture clean-sheet eligibility",
    "rescored_points": "retrospectively harmonized targets from earlier completed rounds, only under explicit proxy availability; 2019/20 missing",
    "price": "latest eligible observed match-row price; frozen between snapshots; historical publication times unverified",
    "won_tackles": "ledger won_tackles only; no mixed native tackles definition"
  },
  "clock_policies": {
    "operational_proxy_v1": {
      "forecast_before_first_actual_round_kickoff_seconds": 5400,
      "availability_after_last_actual_source_kickoff_seconds": 86400,
      "historical_deadline_and_vintage_verified": false
    },
    "conservative_v1": {
      "forecast_before_first_actual_round_kickoff_seconds": 604800,
      "availability_after_last_actual_source_kickoff_seconds": 604800,
      "historical_deadline_and_vintage_verified": false
    }
  }
